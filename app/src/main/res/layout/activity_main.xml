<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF0F5"
    tools:context=".MainActivity">

    <!-- Imagen de la aurora boreal -->
    <ImageView
        android:id="@+id/imagenCentral"
        android:layout_width="257dp"
        android:layout_height="220dp"
        android:layout_marginTop="20dp"
        android:scaleType="fitCenter"
        android:src="@drawable/aurora"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Esto es el texto de 'Hola, + nombre' -->
    <TextView
        android:id="@+id/textoNombre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hola, Usuario"
        android:textColor="#C2185B"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/imagenCentral"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/campoUrl"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Escribe una URL"
        android:visibility="gone"
        android:layout_marginHorizontal="32dp"
        app:layout_constraintTop_toBottomOf="@id/textoNombre"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Aquí empiezan los 4 botones en columna, es decir, uno debajo de otro -->

    <!-- Botón 1: ir a la pantalla de llamada -->
    <ImageButton
        android:id="@+id/botonLlamada"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:src="@android:drawable/ic_menu_call"
        android:backgroundTint="#F8BBD0"
        android:contentDescription="Llamar"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="48dp"
        app:layout_constraintTop_toBottomOf="@id/textoNombre"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Botón 2: abrir la URL en el navegador -->
    <ImageButton
        android:id="@+id/botonUrl"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:src="@android:drawable/ic_menu_compass"
        android:backgroundTint="#F8BBD0"
        android:contentDescription="Abrir URL"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="48dp"
        app:layout_constraintTop_toBottomOf="@id/botonLlamada"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Botón 3: crear la alarma -->
    <ImageButton
        android:id="@+id/botonAlarma"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:src="@android:drawable/ic_menu_send"
        android:backgroundTint="#F8BBD0"
        android:contentDescription="Alarma / Correo"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="48dp"
        app:layout_constraintTop_toBottomOf="@id/botonUrl"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Botón 4: enviar el correo -->
    <ImageButton
        android:id="@+id/botonCorreo"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:src="@android:drawable/ic_menu_myplaces"
        android:backgroundTint="#F8BBD0"
        android:contentDescription="Ubicación / Opción libre"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="48dp"
        app:layout_constraintTop_toBottomOf="@id/botonAlarma"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Botón para volver a la pantalla de configuración -->
    <Button
        android:id="@+id/botonConfig"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="96dp"
        android:backgroundTint="#AD1457"
        android:text="Configuración"
        android:textColor="@android:color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>