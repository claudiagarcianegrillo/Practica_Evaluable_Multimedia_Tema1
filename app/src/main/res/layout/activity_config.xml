<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF0F5"
    tools:context=".ConfigActivity">

    <!-- Título de la pantalla -->
    <TextView
        android:id="@+id/tituloConfig"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Configuración de la App"
        android:textColor="#D81B60"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Campo del nombre -->
    <EditText
        android:id="@+id/campoNombre"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Introduce tu nombre"
        android:textColor="@android:color/black"
        android:textColorHint="#AD1457"
        android:backgroundTint="#F8BBD0"
        android:inputType="textPersonName"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/tituloConfig"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Campo del teléfono -->
    <EditText
        android:id="@+id/campoTelefono"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Introduce teléfono (ej: 112)"
        android:textColor="@android:color/black"
        android:textColorHint="#AD1457"
        android:backgroundTint="#F8BBD0"
        android:inputType="phone"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/campoNombre"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Campo de la URL -->
    <EditText
        android:id="@+id/campoUrl"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Introduce una URL web"
        android:textColor="@android:color/black"
        android:textColorHint="#AD1457"
        android:backgroundTint="#F8BBD0"
        android:inputType="textUri"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/campoTelefono"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Botón que guarda los datos en SharedPreferences y abre la pantalla MainActivity -->
    <Button
        android:id="@+id/botonGuardar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Guardar y Continuar"
        android:backgroundTint="#E91E63"
        android:textColor="@android:color/white"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/campoUrl"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>